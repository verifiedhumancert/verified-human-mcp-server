# Base URL for the Verified Human Cert API
VHC_API_URL=https://verifiedhumancert.com

# HTTP request timeout in seconds
VHC_API_TIMEOUT=15.0

# Max retry attempts for transient transport errors and 5xx responses
VHC_API_RETRIES=2

# Base delay (seconds) for exponential backoff between retries
VHC_API_BACKOFF=0.5

# Server log level — written to stderr (DEBUG, INFO, WARNING, ERROR)
VHC_LOG_LEVEL=WARNING
